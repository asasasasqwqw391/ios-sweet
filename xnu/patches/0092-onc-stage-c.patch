diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -10,6 +10,25 @@
 #if defined(SWEET)
 void sweet_early_init(const boot_args *args);
 void sweet_early_mark(unsigned int stage, const char *label);
+
+/*
+ * onc: raw boot-stage counter that the shim can read back on the next boot.
+ *
+ * sweet_early_mark() paints the panel, which needs a working framebuffer and
+ * which the shim cannot see.  This writes one word to 0xBFEE0000 instead -- the
+ * same slot the start.s markers use -- so the value must be compared in HEX and
+ * every later stage needs a bigger hex value.  The block is mapped once the MMU
+ * is on (0090-onc-sweet-4k-build rounds the bootstrap block count up).
+ * C-level milestones use 0x41+ so they never collide with start.s's 0x06..0x11.
+ */
+static inline void
+onc_stage_raw(unsigned long long stage)
+{
+	*(volatile unsigned long long *)0xBFEE0000ULL = (0x4f4e434d00ULL | stage);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+#define ONC_STAGE(n) onc_stage_raw((unsigned long long)(n))
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
 void sweet_early_relocate(uint64_t base);
