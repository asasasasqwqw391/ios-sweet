diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -347,6 +347,12 @@
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+#if defined(SWEET)
+	/* onc: stage 16 -- we are in C code, past the MMU enable and the ret */
+	*(volatile unsigned long long *)0xBFEE0000ULL = 0x4f4e434d10ULL;
+	__asm__ volatile("dsb sy" ::: "memory");
+#endif
+
 	sweet_early_init(args);
 	sweet_early_mark(1, "arm_init entered (MMU on)");
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -924,6 +924,14 @@
 	dsb	sy
 #endif
 
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d12
+	str	x8, [x9]
+	dc	cvac, x9
+	dsb	sy
+#endif
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -945,6 +953,14 @@
 	// Clear thread pointer
 	msr		TPIDR_EL1, xzr						// Set thread register
 
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d13
+	str	x8, [x9]
+	dc	cvac, x9
+	dsb	sy
+#endif
+
 
 #if defined(APPLE_ARM64_ARCH_FAMILY)
 	mrs		x12, MDSCR_EL1
@@ -958,6 +974,14 @@
 
 	APPLY_TUNABLES x12, x13, x14
 
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d14
+	str	x8, [x9]
+	dc	cvac, x9
+	dsb	sy
+#endif
+
 
 #if HAS_CLUSTER
 	// Unmask external IRQs if we're restarting from non-retention WFI
@@ -986,6 +1010,15 @@
 	mov	lr, x21
 #endif
 
+
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d15
+	str	x8, [x9]
+	dc	cvac, x9
+	dsb	sy
+#endif
+
 	// Return to arm_init()
 	ret
 
