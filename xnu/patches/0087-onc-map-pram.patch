diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 61b44d5..27cc34e 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -718,6 +718,21 @@ Lkernelcache_base_found:
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+
+	/*
+	 * onc: also map the /pram 32MB block (0xBE000000) in the same V=P
+	 * table. /pram is carved out of boot_args memSize, so without this it
+	 * is UNMAPPED and any store data-aborts once the MMU is on -- which
+	 * is exactly what kept eating the early-console log. With the block
+	 * mapped, the kernel can log there safely and it survives the reset.
+	 */
+	MOV64	x10, 0xBE000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
 Lsweet_fb_map_done:
 #endif
 
