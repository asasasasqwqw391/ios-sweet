diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 61b44d5..4761cfd 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -757,6 +757,14 @@ common_start:
 	ldr		x1, [x0, SR_RESTORE_TCR_EL1]
 	MSR_TCR_EL1_X1
 
+#if defined(SWEET)
+	/* onc marker 6 */
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d06
+	str	x8, [x9, #40]
+	dsb	sy
+#endif
+
 	/* Set up translation table base registers.
 	 *	TTBR0 - V=P table @ top of kernel
 	 *	TTBR1 - KVA table @ top of kernel + 1 page
@@ -770,10 +778,26 @@ common_start:
 	mov		x19, lr
 	bl		EXT(set_mmu_ttb)
 	mov		lr, x19
+
+#if defined(SWEET)
+	/* onc marker 7 */
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d07
+	str	x8, [x9, #48]
+	dsb	sy
+#endif
 	add		x0, x25, PGBYTES
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
 
+#if defined(SWEET)
+	/* onc marker 8 */
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d08
+	str	x8, [x9, #56]
+	dsb	sy
+#endif
+
 	// Set up MAIR attr0 for normal memory, attr1 for device memory
 	mov		x0, xzr
 	mov		x1, #(MAIR_WRITEBACK << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITEBACK))
@@ -797,6 +821,14 @@ common_start:
 	tlbi	vmalle1
 	dsb		ish
 
+#if defined(SWEET)
+	/* onc marker 9 */
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d09
+	str	x8, [x9, #64]
+	dsb	sy
+#endif
+
 
 #if defined(BCM2837)
 	// Setup timer interrupt routing; must be done before MMU is enabled
@@ -859,10 +891,27 @@ common_start:
 #endif /* HAS_APPLE_PAC */
 
 	// Enable caches, MMU, ROP and JOP
+#if defined(SWEET)
+	/* onc marker 10 */
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d10
+	str	x8, [x9, #72]
+	dsb	sy
+#endif
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SWEET)
+	/* onc marker 11 */
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d11
+	str	x8, [x9, #80]
+	add	x7, x9, #80
+	dc	cvac, x7
+	dsb	sy
+#endif
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
