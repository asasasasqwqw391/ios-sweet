+/*
+ * onc: persistent early-console log.
+ *
+ * The panel cannot be used as a crash record: ABL repaints its own splash
+ * before the boot shim runs on the next boot, so anything the kernel drew is
+ * gone by the time the shim can look at it. /pram (the top 1 MiB of the DRAM
+ * window) is carved out of the kernel's managed memory and survives the
+ * watchdog reset, but XNU only writes the panic header there once the panic
+ * machinery is up -- a hang before that leaves it untouched.
+ *
+ * So mirror every early-console character into the tail of /pram as well.
+ * Layout at ONC_LOG_PA:
+ *   u32 magic  = ONCL
+ *   u32 length = bytes of text
+ *   char text[]
+ * The boot shim reads this back on the next boot and prints it, which gives
+ * the exact stage the kernel reached even when it dies before panicking.
+ */
+#define ONC_LOG_MAGIC  0x4f4e434cU
+#define ONC_LOG_PA     0xBFF80000UL
+#define ONC_LOG_MAX    0x00010000U
+
+static void
+onc_early_log_char(char c)
+{
+	volatile uint32_t *h = (volatile uint32_t *)(uintptr_t)ONC_LOG_PA;
+	volatile char *buf = (volatile char *)(uintptr_t)(ONC_LOG_PA + 8);
+	uint32_t len = h[1];
+
+	if (h[0] != ONC_LOG_MAGIC) {
+		h[0] = ONC_LOG_MAGIC;
+		len = 0;
+	}
+	if (len < ONC_LOG_MAX - 1) {
+		buf[len] = c;
+		h[1] = len + 1;
+	}
+}
+
 extern unsigned char iso_font[256 * 16];
 
 /* Initialized data must remain writable until disable, including panics. */
@@ -88,6 +127,7 @@ sweet_early_putc(char c)
 	if (early_disabled) {
 		return;
 	}
+	onc_early_log_char(c);
