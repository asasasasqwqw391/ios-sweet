+/*
+ * onc: persistent early-console log.
+ *
+ * The panel is not usable as a crash record -- ABL repaints its own splash
+ * before the shim runs on the next boot -- so mirror the console into plain
+ * RAM that the shim reads back after the watchdog reset.
+ *
+ * Address choice matters: the bootstrap V=P mapping only covers the kernel's
+ * managed window 0x98000000..0xBFF00000 (memSize excludes the /pram carve),
+ * so anything in /pram is UNMAPPED and the first store data-aborts. Keep the
+ * log just below that boundary, at the top of the mapped window, which early
+ * boot leaves untouched.
+ *
+ * Layout at ONC_LOG_PA:
+ *   u32 magic  = ONCL
+ *   u32 length = bytes of text
+ *   char text[]
+ */
+#define ONC_LOG_MAGIC  0x4f4e434cU
+#define ONC_LOG_PA     0xBFFA0000UL
+#define ONC_LOG_MAX    0x0000f000U
+
+static void
+onc_early_log_char(char c)
+{
+	volatile uint32_t *h = (volatile uint32_t *)(uintptr_t)ONC_LOG_PA;
+	volatile char *buf = (volatile char *)(uintptr_t)(ONC_LOG_PA + 8);
+	uint32_t len = h[1];
+
+	if (h[0] != ONC_LOG_MAGIC) {
+		h[0] = ONC_LOG_MAGIC;
+		len = 0;
+	}
+	if (len < ONC_LOG_MAX - 1) {
+		buf[len] = c;
+		h[1] = len + 1;
+	}
+}
+
+/* Record a stage number in the log BEFORE touching the panel. */
+static void
+onc_log_stage(unsigned int stage)
+{
+	onc_early_log_char((char)10);
+	onc_early_log_char('[');
+	onc_early_log_char('S');
+	if (stage >= 10) {
+		onc_early_log_char((char)('0' + stage / 10));
+	}
+	onc_early_log_char((char)('0' + stage % 10));
+	onc_early_log_char(']');
+}
+
